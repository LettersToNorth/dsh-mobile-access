{
  "name": "dsh-mobile-access",
  "version": "0.1.3",
  "description": "在同一 Wi-Fi 下用手机浏览器安全访问并操作桌面端 DeepSeek Harness 的同一个 Web GUI：会话实时同步，可直接发送指令、回答提问、审批与操作。零外部依赖、离线二维码、一次性配对码。Open the same desktop Web GUI from a phone browser on your local network: sessions stay in sync, send prompts, answer questions, approve and operate directly. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LettersToNorth/dsh-mobile-access.git"
  },
  "homepage": "https://github.com/LettersToNorth/dsh-mobile-access#readme",
  "bugs": "https://github.com/LettersToNorth/dsh-mobile-access/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "phone",
    "remote-access",
    "lan",
    "reverse-proxy",
    "qr"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "public/*",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-mobile-access",
    "summary": "同一 Wi-Fi 下用手机打开桌面端同一个 Web GUI：会话实时同步、可发指令/审批/操作；扫码配对、一次性配对码、零外部依赖。",
    "categories": [
      "远程访问",
      "Web UI",
      "手机"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check public/app.js && node --check public/panel.js && node --check public/qr.js",
    "test": "node tests/verify.mjs"
  }
}
